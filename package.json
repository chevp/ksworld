{
  "name": "ksworld",
  "version": "0.1.0",
  "description": "ksworld — worldctl's web-safe capabilities (query/content/layout/gamedna/status/propose/plan/resolve/learn) as a standalone GitHub Action. No native eon.exe/nexo.exe/claude execution.",
  "type": "module",
  "bin": {
    "ksworld": "./bin/ksworld"
  },
  "main": "./dist/cli/ksworld.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/ksworld.ts",
    "start": "node dist/cli/ksworld.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.20.0",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.3.1",
    "tsx": "^4.19.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
